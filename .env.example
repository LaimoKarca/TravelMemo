APP_ENV=development
PUBLIC_URL=http://localhost:5173
ALLOWED_EMAILS=friend@example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_DAYS=7
COOKIE_SECURE=false
OTP_SECONDS=600
RESEND_SECONDS=60
OTP_ATTEMPTS=5
EMAIL_HOURLY_LIMIT=5
IP_HOURLY_LIMIT=20
VERIFY_IP_HOURLY_LIMIT=100
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-random-database-password
NEO4J_DATABASE=neo4j
# Local dev Mailpit. Production: use your provider's SMTP and encrypted TLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USER=
SMTP_AUTH=true
SMTP_PASSWORD=
SMTP_FROM=TravelMemo <noreply@example.com>
SMTP_TIMEOUT=10
# Optional for AI conversations; management and search also work without this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT=45
OPENAI_MAX_OUTPUT_TOKENS=2000
AI_USER_CONCURRENCY=1
AI_GLOBAL_CONCURRENCY=2
CONVERSATION_HISTORY_LIMIT=12
CONVERSATION_EVIDENCE_LIMIT=8
# Summary older turns in batches; cap serialized prompt size (characters, not tokens).
CONVERSATION_SUMMARY_TRIGGER=12
CONVERSATION_SUMMARY_CHARS_TRIGGER=12000
CONVERSATION_PROMPT_MAX_CHARS=24000
# Image understanding uses OPENAI_MODEL when VISION_MODEL is empty.
VISION_MODEL=
FOOTPRINT_ASSIST_MAX_OUTPUT_TOKENS=6000
FOOTPRINT_ASSIST_CONCURRENCY=2
MEDIA_ROOT=data/media
MEDIA_UPLOAD_MAX_BYTES=20971520
MEDIA_MAX_PIXELS=50000000
MEDIA_MAX_DIMENSION=2048
MEDIA_IMAGE_MAX_BYTES=524288
MEDIA_THUMBNAIL_MAX_BYTES=65536
MEDIA_USER_QUOTA_BYTES=262144000
MEDIA_GLOBAL_QUOTA_BYTES=5368709120
MEDIA_POLL_SECONDS=3
MEDIA_ORPHAN_SECONDS=3600
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_DIR=data/models/multilingual-e5-small
EMBEDDING_POLL_SECONDS=3
EMBEDDING_RETRY_SECONDS=60
RETRIEVAL_TOP_K=50
RRF_K=60
RELATION_WEIGHT=0.5
# Separate cloudflared connector uses TUNNEL_TOKEN; see docs/CLOUDFLARE_TUNNEL.md.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
