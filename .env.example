APP_ENV=development
PUBLIC_URL=http://localhost:5173
ALLOWED_EMAILS=friend@example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_DAYS=7
COOKIE_SECURE=false
OTP_SECONDS=600
RESEND_SECONDS=60
OTP_ATTEMPTS=5
EMAIL_HOURLY_LIMIT=5
IP_HOURLY_LIMIT=20
VERIFY_IP_HOURLY_LIMIT=100
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-random-database-password
NEO4J_DATABASE=neo4j
# Local dev Mailpit. Production: use your provider's SMTP and encrypted TLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USER=
SMTP_AUTH=true
SMTP_PASSWORD=
SMTP_FROM=TravelMemo <noreply@example.com>
SMTP_TIMEOUT=10
# Reserved for phases 3-5, not used by phase 1:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
